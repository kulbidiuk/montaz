# Автоматический разбор инбокса через Claude Code (headless).
# Скопируй нужные строки в свой crontab:  crontab -e
#
# Замени /path/to/vault на путь к своему хранилищу Obsidian.
# Claude Code запускается в папке vault, поэтому видит CLAUDE.md с правилами разбора.

# Лёгкий разбор 3 раза в день — 09:00 / 13:00 / 19:00
0 9,13,19 * * *  cd /path/to/vault && claude -p "разбери инбокс" >> /path/to/vault/_BRAIN/.triage.log 2>&1

# Утром — полный дайджест в 07:00 (разбор + сводка дня в Дайджесты/ДАТА.md)
0 7 * * *  cd /path/to/vault && claude -p "разбери инбокс и собери утренний дайджест на сегодня" >> /path/to/vault/_BRAIN/.triage.log 2>&1
